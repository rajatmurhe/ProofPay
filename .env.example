# Local only. API is bound to loopback; no authentication is implemented.
DATABASE_URL=sqlite:///./proofpay.db
LOCAL_OWNER=local-demo
PROCESSING_MODE=rules
API_URL=http://127.0.0.1:8017
# Optional live provider, using an OpenAI-compatible chat/completions endpoint.
# API access is separate from subscriptions to chat applications.
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Account protection. Demo mode is explicitly local-only.
ENVIRONMENT=development
AUTH_MODE=authenticated
ENABLE_REGISTRATION=true
ALLOWED_HOSTS=127.0.0.1,localhost
LOCAL_WEB_ORIGIN=http://127.0.0.1:3017
# Gmail OAuth. Fill these only in your ignored server .env.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CONNECTOR_ENCRYPTION_KEY=
